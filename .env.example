# VazhiSync configuration — copy to .env and fill in. Never commit .env.

# --- Infrastructure ---
# Host port 5434 (5432/5433 are used by local PostgreSQL installs on the dev machine).
# Inside docker-compose, services use host "postgres" and port 5432 instead.
DATABASE_URL=postgresql+asyncpg://vazhisync:change-me@localhost:5434/vazhisync
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Bunching detection ---
STALE_GPS_SECONDS=60
BUNCHING_RATIO=0.5
CLOSING_RATIO=0.75

# --- Workflow limits ---
SIM_TIMEOUT_SECONDS=10
SIM_CONCURRENCY=4
MAX_GRAPH_STEPS=25

# --- LLMs (LiteLLM model strings) ---
PRIMARY_MODEL=
BACKUP_MODEL=
LOCAL_MODEL=ollama/qwen3:8b
# Ollama runs natively on the host; from containers use http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434

# --- Provider API keys ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- API ---
CORS_ORIGINS=http://localhost:5173
