# VazhiSync configuration — copy to .env and fill in. Never commit .env.
# Values marked change-me must be replaced. Avoid @ : / in passwords (they go into URLs).

# --- Postgres (docker compose) ---
POSTGRES_USER=vazhisync
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vazhisync

# --- Infrastructure (values for running the backend on the host) ---
# Host port 5434 (5432/5433 are used by local PostgreSQL installs on the dev machine).
# Inside docker compose these are overridden to use the service names postgres:5432 / redis:6379.
DATABASE_URL=postgresql+asyncpg://vazhisync:change-me@localhost:5434/vazhisync
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# At least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
# Login and register attempts per client IP per minute
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Bunching detection ---
STALE_GPS_SECONDS=60
BUNCHING_RATIO=0.5
CLOSING_RATIO=0.75

# --- Workflow limits ---
SIM_TIMEOUT_SECONDS=10
SIM_CONCURRENCY=4
MAX_GRAPH_STEPS=25

# --- Live world runner (B6) ---
WORLD_ROUTE_ID=32B
WORLD_SEED=1
# Starting speed (1, 5 or 10); officers change it at runtime
WORLD_SPEED=1
# Real seconds between ticks (1-5)
WORLD_TICK_SECONDS=2
WORLD_QUEUE_EVERY_SECONDS=10
WORLD_RETENTION_HOURS=6
# GPS dropouts (simulated seconds from the start), JSON, e.g.
# WORLD_GPS_DROPOUTS=[{"bus_id": "32B-05", "start_s": 300, "duration_s": 240}]
WORLD_GPS_DROPOUTS=[]

# --- LLMs (LiteLLM model strings) ---
PRIMARY_MODEL=
BACKUP_MODEL=
LOCAL_MODEL=ollama/qwen3:8b
# Ollama runs natively on the host; containers use http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434

# --- Provider API keys ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Jev decision tier (optional, B24; stays off without an API key) ---
JEV_ENABLED=false
JEV_API_KEY=

# --- Langfuse: Langfuse Cloud (set LANGFUSE_HOST to the cloud URL) or self-hosted via the
# "observability" compose profile ---
# The app uses these keys; the Langfuse container also creates a project with them on first start.
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ADMIN_EMAIL=admin@vazhisync.local
LANGFUSE_ADMIN_PASSWORD=change-me
# Generate: python -c "import secrets; print(secrets.token_hex(32))"  (ENCRYPTION_KEY must be 64 hex chars)
LANGFUSE_ENCRYPTION_KEY=change-me
LANGFUSE_SALT=change-me
LANGFUSE_NEXTAUTH_SECRET=change-me
CLICKHOUSE_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me

# --- API ---
CORS_ORIGINS=http://localhost:5173
